# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Admin Email 6-Digit OTP Verification Server (Backend Secrets)
# ---------------------------------------------------------------------------
# Gmail SMTP (Option 1 — recommended free setup):
# Generate a 16-character App Password under Google Account -> Security -> App passwords.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Resend API (Option 2 — alternative to Gmail SMTP):
RESEND_API_KEY=""
OTP_EMAIL_FROM=""

# Secret used to sign 12-hour OTP session tokens & HMAC OTP hashes (set a long random string in production):
OTP_SESSION_SECRET=""

# Optional comma-separated list of allowed CORS origins (e.g. https://malaka2003.github.io):
ALLOWED_ORIGINS=""

# Set to "true" when deploying server.ts as a standalone OTP API backend for GitHub Pages:
OTP_SERVER_ONLY="false"

# Frontend build variable: set when frontend is hosted statically (e.g. GitHub Pages)
# to your free Google Apps Script Web App URL (https://script.google.com/macros/s/.../exec)
# or custom OTP server URL:
VITE_OTP_API_URL=""
